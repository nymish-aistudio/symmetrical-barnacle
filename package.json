{
  "name": "aistudio-site",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "AiStudio — go where the work is. A narrative descent, in WebGL.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
