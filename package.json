    "typecheck": "tsc --noEmit",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "maath": "^0.10.8",
    "postprocessing": "^6.39.5",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
